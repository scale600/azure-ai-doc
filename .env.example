# =============================================================================
# Environment template — copy to `.env` and fill in. `.env` is gitignored.
# Used by local tooling (az CLI / terraform / scripts), NOT read by the app at
# runtime (the app uses Key Vault + Managed Identity in Azure).
# =============================================================================

# --- Azure (from `az login`) -------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus

# --- Terraform ---------------------------------------------------------------
# 4-6 lowercase alphanumeric chars. Must be globally unique across all Azure
# tenants for storage/blob/etc. Pick something like your initials + a number.
TF_VAR_unique_suffix=

# --- Cloudflare (OPTIONAL — manual DNS is the default) -----------------------
# If you want Terraform to manage the DNS record automatically, provide an API
# token scoped to Zone:DNS:Edit for the techcloudup.com zone, plus the zone id.
# Leave empty for manual DNS (see docs/implementation-checklist.md §7).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Local Function development (src/) ---------------------------------------
# Values used only when running the Function App locally (func start).
# In Azure these come from Key Vault references / app settings via Terraform.
DOCUMENT_STORAGE_CONNECTION=
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
API_KEY=
